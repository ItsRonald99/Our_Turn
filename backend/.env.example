# Copy this file to backend/.env and fill in values for local development.
# In production (Railway, etc.) set these as environment variables in the dashboard.

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite file. In production, point this at your mounted volume.
DATABASE_URL=file:./dev.sqlite
# Production example (Railway volume mounted at /data):
# DATABASE_URL=file:/data/production.sqlite

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your production domain when the frontend is on a different origin.
# When serving the frontend from the same Express process (recommended), this
# env var is not strictly required but can be set for explicitness.
CORS_ORIGIN=http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_256_bit_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Email reminders (optional) ────────────────────────────────────────────────
# When unset, reminder digests are logged to the console instead of sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
