# Copy to backend/.env and fill in values

# Database
# DATABASE_URL=file:./dev.sqlite

# Server
# PORT=3001

# CORS — set to your frontend origin in production
# CORS_ORIGIN=http://localhost:5173

# JWT — MUST be a long random secret in production (e.g. openssl rand -hex 32)
# JWT_SECRET=replace_with_a_random_256_bit_secret
# JWT_EXPIRES_IN=15m

# Refresh token lifetime in days
# REFRESH_TOKEN_EXPIRES_DAYS=7
