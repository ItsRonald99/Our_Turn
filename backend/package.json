{
  "name": "our-turn-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node --no-warnings -e \"require('fs').cpSync('src','dist',{recursive:true})\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.9"
  }
}
