{
  "name": "our-turn-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node src/index.js",
    "build": "node --input-type=module -e \"import {cpSync,rmSync} from 'fs'; try{rmSync('dist',{recursive:true})}catch{} cpSync('src','dist',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "reminders:send": "node --env-file-if-exists=.env src/scripts/send-reminders.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.9",
    "supertest": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
